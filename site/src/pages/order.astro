---
// Оформление заказа (как страница заказа milovini-samara): корзина + контакты → приёмник Tilda (форма «Cart»).
import Base from '../layouts/Base.astro';
import Order from '../islands/Order';
import { u, SITE } from '../lib/site';
---
<Base title="Оформление заказа | TEYES SIBIR" description="Оформление заказа в магазине TEYES SIBIR.">
  <div class="wrap orderpage">
    <ol class="crumbs"><li><a href={u('/')}>Главная</a></li><li><a href={u('/store/')}>Магазин</a></li></ol>
    <h1>Оформление заказа</h1>
    <Order client:load storeHref={u('/store/')} policyHref={u('/politica/')} phone={SITE.phone} />
  </div>
</Base>

<style is:global>
  .orderpage { padding-top: 20px; display: grid; gap: 20px; }
  .orderpage h1 { font-size: clamp(28px, 4vw, 40px); }
  .order { display: grid; gap: 24px; }
  @media (min-width: 900px) { .order { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 40px; align-items: start; } }
  .order h2, .order__done h2 { font-size: 22px; margin-bottom: 12px; }
  .order__items, .order__form { min-width: 0; padding: 20px; border: 1px solid var(--tx-line); border-radius: var(--tx-r); }
  .order__items .drawer__list { padding: 0; }
  .order__items .drawer__sum { margin-top: 16px; }
  .order__form { display: grid; gap: 14px; }
  .field { display: grid; gap: 6px; font-size: 14px; }
  .field span { color: var(--tx-muted); }
  .field input, .field textarea { width: 100%; min-height: 48px; padding: 12px 14px; border: 1px solid var(--tx-line); border-radius: 12px; font: inherit; font-size: 16px; color: var(--tx-ink); background: var(--tx-bg); }
  .field input[aria-invalid='true'] { border-color: var(--tx-sale); }
  .field em, .field__err { font-style: normal; font-size: 13px; color: var(--tx-sale); }
  .check { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; font-size: 14px; cursor: pointer; }
  .check input { width: 20px; height: 20px; margin: 1px 0 0; accent-color: var(--tx-accent); }
  .order__note { margin: 0; font-size: 13px; color: var(--tx-muted); }
  .order__done { display: grid; gap: 14px; justify-items: start; padding: 24px; border: 1px solid var(--tx-line); border-radius: var(--tx-r); }
  .order__done p { margin: 0; }
</style>
